# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Database (Postgres — e.g. Neon or Supabase connection string) ---
# ON VERCEL YOU DO NOT NEED TO SET THESE. Adding the Supabase integration
# injects POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING, which the app
# reads automatically (see src/lib/db-url.ts). These are for local dev.
#
# Runtime queries use the POOLED string (Supabase: port 6543); migrations use
# the DIRECT/session one (port 5432). Setting DATABASE_URL alone is fine for
# local development, where both are the same database.
DATABASE_URL="postgresql://user:password@host:5432/kasi?sslmode=require"

# Optional. Overrides the direct connection used by `prisma migrate`.
DIRECT_URL=""

# Optional. Max connections per app instance (default 5). Lower it when the
# database's connection limit is tight and no external pooler is in front.
DATABASE_POOL_MAX=""

# --- Web address (src/lib/site.ts) ---
# The one address people use for KASI, without https://. Every other
# company address (e.g. erp.solomontechsolutions.co.tz) redirects here.
# Face ID / fingerprint sign-in (passkeys) is tied to this address, so set it
# BEFORE anyone sets up Face ID, and don't change it afterwards.
KASI_CANONICAL_HOST="erp.solomontechsolutions.com"
# Optional: "solomontechsolutions.com" lets the same passkeys work on any
# subdomain of the .com domain. Leave empty to tie them to the host above.
WEBAUTHN_RP_ID=""

# --- Auth.js ---
# Signs session cookies. Generate with: npx auth secret
# On Vercel with the Supabase integration this is derived from the injected
# Supabase secret if unset, so the app boots — but SET IT EXPLICITLY: it keeps
# the login key independent of Supabase key rotation, which signs everyone out.
AUTH_SECRET=""

# --- One-time setup (src/app/api/setup/route.ts) ---
# Set this to any long random phrase (16+ characters) to open /api/setup once,
# which creates the company record, roles and the nine initial users and shows
# their temporary passwords. DELETE this variable once you have them — while it
# is set, anyone holding the token can reach that route.
SETUP_TOKEN=""

# --- Object storage for uploaded documents (Section 11) ---
# Fill in once a provider (e.g. S3-compatible or Vercel Blob) is chosen.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""

# --- Outbound email (Section 17.1) ---
# Sending domain: solomontechsolutions.com (per Phase 1 decision)
EMAIL_FROM="KASI <no-reply@solomontechsolutions.com>"
EMAIL_PROVIDER_API_KEY=""

# --- Africa's Talking (SMS today; WhatsApp product to evaluate — Section 17.2/17.3) ---
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""

# --- Selcom revenue reports (src/lib/integrations/selcom.ts) ---
# The same API key and secret entered in BillNasi under Settings > Payment
# Gateway. KASI only READS the order list for reports; it never creates,
# changes or cancels a payment.
SELCOM_API_KEY=""
SELCOM_API_SECRET=""
# Set to "false" to use Selcom's test gateway (apigwtest.selcommobile.com).
SELCOM_LIVE="true"
# Optional: override the full base URL, e.g. https://apigw.selcommobile.com/v1
SELCOM_BASE_URL=""

# --- Scheduled jobs (src/app/api/cron/tick/route.ts) ---
# Long random value (16+ characters). The scheduler sends it as
# "Authorization: Bearer <CRON_SECRET>". Vercel Cron does this automatically.
CRON_SECRET=""

# --- Phone notifications (Web Push) ---
# A key pair that identifies this KASI server to the push services run by
# Apple, Google and Mozilla, so only KASI can send notifications to the
# phones that enabled them. Not a Selcom or BillNasi credential, not tied to
# any account: generate one pair yourself, once, with
#   npx web-push generate-vapid-keys
# The PUBLIC key is safe to expose (browsers need it). Keep the PRIVATE key
# secret. Changing the pair later turns notifications off on every device
# until each person enables them again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@solomontechsolutions.com"

# --- Online meetings (src/lib/meetings.ts) ---
# Recommended: 8x8 Jitsi as a Service (jaas.8x8.vc). Paste the private key
# with its line breaks written as \n.
JAAS_APP_ID=""
JAAS_API_KEY_ID=""
JAAS_PRIVATE_KEY=""
# Alternative: a Jitsi server (self-hosted is best for secrecy). With
# JITSI_APP_ID/JITSI_APP_SECRET set, the server must use token auth.
JITSI_DOMAIN="meet.jit.si"
JITSI_APP_ID=""
JITSI_APP_SECRET=""
